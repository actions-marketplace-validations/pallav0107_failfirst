{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pallav0107/failfirst/schemas/verify-report.schema.json",
  "title": "failfirst verify report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "version",
    "phase",
    "status",
    "exit_code",
    "summary",
    "criteria"
  ],
  "properties": {
    "tool": {
      "const": "failfirst"
    },
    "version": {
      "type": "string"
    },
    "phase": {
      "const": "verify"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "awaiting_review"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        1,
        3
      ]
    },
    "summary": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "awaiting_review",
          "unbaselined",
          "modified",
          "vacuous",
          "baseline_error",
          "proven",
          "still_failing",
          "error",
          "removed"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "error",
            "n/a"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "judgment",
        "verdict",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "judgment": {
          "type": "boolean"
        },
        "verdict": {
          "enum": [
            "awaiting_review",
            "unbaselined",
            "modified",
            "vacuous",
            "baseline_error",
            "proven",
            "still_failing",
            "error",
            "removed"
          ]
        },
        "reason": {
          "type": "string"
        },
        "baseline": {
          "$ref": "#/$defs/evaluation"
        },
        "now": {
          "$ref": "#/$defs/evaluation"
        }
      }
    }
  }
}
