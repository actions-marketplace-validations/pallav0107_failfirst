{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pallav0107/failfirst/schemas/baseline-report.schema.json",
  "title": "failfirst baseline report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "version",
    "phase",
    "status",
    "exit_code",
    "summary",
    "criteria"
  ],
  "properties": {
    "tool": {
      "const": "failfirst"
    },
    "version": {
      "type": "string"
    },
    "phase": {
      "const": "baseline"
    },
    "status": {
      "enum": [
        "ok",
        "warning"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        1
      ]
    },
    "dry_run": {
      "const": true
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failed_as_required",
        "vacuous",
        "errored",
        "judgment"
      ],
      "properties": {
        "failed_as_required": {
          "type": "integer",
          "minimum": 0
        },
        "vacuous": {
          "type": "integer",
          "minimum": 0
        },
        "errored": {
          "type": "integer",
          "minimum": 0
        },
        "judgment": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "error",
            "n/a"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "judgment",
        "baseline",
        "vacuous"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "judgment": {
          "type": "boolean"
        },
        "baseline": {
          "$ref": "#/$defs/evaluation"
        },
        "vacuous": {
          "type": "boolean"
        }
      }
    }
  }
}
